    <script>
        var currentLang = 'es';

        function toggleLanguage() {
            currentLang = currentLang === 'es' ? 'en' : 'es';
            document.documentElement.lang = currentLang;
            document.getElementById('langToggle').textContent = currentLang === 'es' ? 'EN' : 'ES';

            // Update document title
            var titleEl = document.querySelector('title');
            if (titleEl && titleEl.dataset[currentLang]) {
                document.title = titleEl.dataset[currentLang];
            }

            // Update all translatable elements (excluding <title>)
            document.querySelectorAll('[data-es][data-en]:not(title)').forEach(function(el) {
                el.textContent = el.dataset[currentLang];
            });
        }
    </script>
